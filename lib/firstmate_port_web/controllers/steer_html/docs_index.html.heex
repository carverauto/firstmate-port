<div class="doc">
  <.link navigate={~p"/steer"} class="back">Back to fm-steer</.link>
  <h1>Docs</h1>
  <p class="muted">Short pages for operators and for agents calling the API.</p>
  <h2>Pages</h2>
  <ul>
    <li :for={page <- FirstmatePortWeb.SteerDocs.index()}>
      <.link navigate={~p"/steer/docs/#{page.slug}"}>{page.title}</.link>
      <span class="muted">{page.path}</span>
    </li>
  </ul>
  <p>Each page is the repo markdown itself, so there is no second copy to keep in sync.</p>
</div>
