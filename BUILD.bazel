load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(
    "//build:elixir_release.bzl",
    "SHIPPED_ERTS_OTP_ROOT",
    "SHIPPED_ERTS_ROOT_MARKER",
    "elixir_release",
)
load("//build:phoenix_digest.bzl", "phoenix_digest")

package(default_visibility = ["//visibility:public"])

exports_files([
    "mix.lock",
    "go.mod",
    "go.sum",
])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = [
            "bazel-*",
            "_build/**",
            "deps/**",
            "node_modules/**",
            "tmp/**",
            ".git/**",
        ],
    ),
)

filegroup(
    name = "compile_srcs",
    srcs = glob(
        [
            "lib/**",
            "config/**",
            "priv/**",
            "assets/**",
            "mix.exs",
            "mix.lock",
        ],
        exclude = [
            "priv/static/assets/**",
            "priv/static/cache_manifest.json",
        ],
    ) + glob(
        ["test/support/**"],
        allow_empty = True,
    ),
)

PORT_DEPS = [
    "@hexpm//:ash",
    "@hexpm//:ash_ai",
    "@hexpm//:ash_cloak",
    "@hexpm//:ash_events",
    "@hexpm//:ash_oban",
    "@hexpm//:ash_paper_trail",
    "@hexpm//:ash_phoenix",
    "@hexpm//:ash_postgres",
    "@hexpm//:bandit",
    "@hexpm//:cloak",
    "@hexpm//:dns_cluster",
    "@hexpm//:ecto_sql",
    "@hexpm//:esbuild",
    "@hexpm//:gettext",
    "@hexpm//:gnat",
    "@hexpm//:guardian",
    "@hexpm//:jason",
    "@hexpm//:oban",
    "@hexpm//:phoenix",
    "@hexpm//:phoenix_ecto",
    "@hexpm//:phoenix_html",
    "@hexpm//:phoenix_live_dashboard",
    "@hexpm//:phoenix_live_view",
    "@hexpm//:postgrex",
    "@hexpm//:req",
    "@hexpm//:req_llm",
    "@hexpm//:simple_sat",
    "@hexpm//:swoosh",
    "@hexpm//:tailwind",
    "@hexpm//:telemetry_metrics",
    "@hexpm//:telemetry_poller",
    "@hexpm//:ueberauth",
    "@hexpm//:ueberauth_oidcc",
    "@rules_elixir//elixir",
]

mix_app(
    name = "erlang_app",
    srcs = [":compile_srcs"],
    app_name = "firstmate_port",
    deps = PORT_DEPS,
)

elixir_release(
    name = "release",
    srcs = [":compile_srcs"],
    out = "firstmate-port-release.tar.gz",
    app = ":erlang_app",
    erts_otp_root = SHIPPED_ERTS_OTP_ROOT,
    erts_root_marker = SHIPPED_ERTS_ROOT_MARKER,
    mix_env = "prod",
    overlays = {
        ":static": "priv",
    },
)

# Browser assets, built by Bazel instead of inside the release action. Same
# `mix assets.deploy` flow as the Dockerfile (tailwind --minify, esbuild
# --bundle --minify, phx.digest) with pinned standalone binaries instead of
# `mix assets.setup` downloads. Pattern from serviceradar //elixir/web-ng/assets.

filegroup(
    name = "asset_srcs",
    srcs = glob(["assets/**"]),
)

# css/app.css @sources the HEEx templates, so Tailwind reads them to decide
# which utilities to emit. Without these the stylesheet builds clean and ships
# almost empty.
filegroup(
    name = "web_templates",
    srcs = glob(["lib/firstmate_port_web/**"]),
)

# Static files that are committed rather than generated. The generated
# priv/static/assets tree and cache_manifest.json come from :static below,
# never from source (compile_srcs excludes them for the same reason). The
# **/*.gz exclude is the same rule: a local `mix phx.digest` writes compressed
# siblings next to the sources, and the digest step regenerates them.
filegroup(
    name = "static_files",
    srcs = glob(
        ["priv/static/**"],
        exclude = [
            "priv/static/assets/**",
            "priv/static/cache_manifest.json",
            "priv/static/**/*.gz",
        ],
    ),
)

# Selected on the target platform: under --config=remote target == exec ==
# linux x86_64; on a workstation target == exec == host.
alias(
    name = "tailwind_bin",
    actual = select({
        "//build/platforms:target_linux_arm64": "@tailwind_linux_arm64//file:file",
        "//build/platforms:target_linux_x86_64": "@tailwind_linux_x86_64//file:file",
        "//build/platforms:target_darwin_arm64": "@tailwind_darwin_arm64//file:file",
        "//build/platforms:target_darwin_x86_64": "@tailwind_darwin_x86_64//file:file",
    }),
)

alias(
    name = "esbuild_bin",
    actual = select({
        "//build/platforms:target_linux_arm64": "@esbuild_linux_arm64//:bin",
        "//build/platforms:target_linux_x86_64": "@esbuild_linux_x86_64//:bin",
        "//build/platforms:target_darwin_arm64": "@esbuild_darwin_arm64//:bin",
        "//build/platforms:target_darwin_x86_64": "@esbuild_darwin_x86_64//:bin",
    }),
)

# The SVGs the vendor/heroicons tailwind shim reads (see MODULE.bazel).
copy_to_directory(
    name = "heroicons_opt",
    srcs = ["@heroicons//:optimized"],
    include_external_repositories = ["+http_archive+heroicons"],
)

genrule(
    name = "css_bundle",
    srcs = [
        ":asset_srcs",
        ":web_templates",
        ":heroicons_opt",
    ],
    outs = ["static_build/assets/css/app.css"],
    # The heroicons shim resolves `../../deps/heroicons` from its own path
    # (assets/vendor/), so recreate the Mix deps/ layout beside the sources.
    cmd = """
        set -euo pipefail
        ROOT=$$PWD
        rm -rf "$$ROOT/deps"
        mkdir -p "$$ROOT/deps"
        ln -s "$$ROOT/$(location :heroicons_opt)" "$$ROOT/deps/heroicons"
        "$(location :tailwind_bin)" --input=assets/css/app.css --output=$(OUTS) --minify
    """,
    tools = [":tailwind_bin"],
)

# One directory per Hex package so esbuild sees the same deps/ layout Mix
# gives it (one NODE_PATH entry per package directory).
copy_to_directory(
    name = "dep_phoenix",
    srcs = ["@hex_phoenix//:sources"],
    include_external_repositories = ["+hex+hex_phoenix"],
)

copy_to_directory(
    name = "dep_phoenix_html",
    srcs = ["@hex_phoenix_html//:sources"],
    include_external_repositories = ["+hex+hex_phoenix_html"],
)

copy_to_directory(
    name = "dep_phoenix_live_view",
    srcs = ["@hex_phoenix_live_view//:sources"],
    include_external_repositories = ["+hex+hex_phoenix_live_view"],
)

genrule(
    name = "js_bundle",
    srcs = [
        ":asset_srcs",
        ":dep_phoenix",
        ":dep_phoenix_html",
        ":dep_phoenix_live_view",
        "//build:phoenix-colocated-index.js",
    ],
    outs = ["static_build/assets/js/app.js"],
    cmd = """
        set -euo pipefail
        ROOT=$$PWD
        ESBUILD="$$ROOT/$(location :esbuild_bin)"
        OUT="$$ROOT/$(OUTS)"
        W="$$ROOT/js_bundle_work"
        rm -rf "$$W"
        mkdir -p "$$W/deps" "$$W/bp/phoenix-colocated/firstmate_port"
        ln -s "$$ROOT/$(location :dep_phoenix)" "$$W/deps/phoenix"
        ln -s "$$ROOT/$(location :dep_phoenix_html)" "$$W/deps/phoenix_html"
        ln -s "$$ROOT/$(location :dep_phoenix_live_view)" "$$W/deps/phoenix_live_view"
        cp "$$ROOT/$(location //build:phoenix-colocated-index.js)" "$$W/bp/phoenix-colocated/firstmate_port/index.js"
        cd assets
        NODE_PATH="$$W/deps:$$W/bp" "$$ESBUILD" js/app.js --bundle --target=es2022 --outfile="$$OUT" --external:'/fonts/*' --external:'/images/*' --alias:@=. --minify
    """,
    tools = [":esbuild_bin"],
)

# The undigested static tree: generated bundles plus the committed files.
# config/prod.exs sets cache_static_manifest, so the release needs the
# digested tree, not this one; it exists only as the digest input.
copy_to_directory(
    name = "static_undigested",
    srcs = [
        ":css_bundle",
        ":js_bundle",
        ":static_files",
    ],
    replace_prefixes = {
        "static_build/": "",
        "priv/static/": "",
    },
)

phoenix_digest(
    name = "static",
    src = ":static_undigested",
    out = "static.tar.gz",
    prefix = "static",
)

go_library(
    name = "fmsteer_lib",
    srcs = [
        "internal/fmsteer/auth.go",
        "internal/fmsteer/cli.go",
        "internal/fmsteer/client.go",
        "internal/fmsteer/creds.go",
        "internal/fmsteer/inbox.go",
        "internal/fmsteer/ingest.go",
    ],
    importpath = "github.com/mfreeman451/firstmate-port/internal/fmsteer",
)

go_library(
    name = "fm-steer_lib",
    srcs = ["cmd/fm-steer/main.go"],
    importpath = "github.com/mfreeman451/firstmate-port/cmd/fm-steer",
    deps = [":fmsteer_lib"],
)

go_binary(
    name = "fm-steer",
    embed = [":fm-steer_lib"],
)

# Cross-compiled fm-steer CLIs for GitHub Release assets.
# Same go_cross_binary shape as serviceradar native add-ons.
[
    go_cross_binary(
        name = "fm-steer_" + os + "_" + arch,
        platform = "@io_bazel_rules_go//go/toolchain:{}_{}".format(os, arch),
        target = ":fm-steer",
    )
    for (os, arch) in [
        ("linux", "amd64"),
        ("linux", "arm64"),
        ("darwin", "amd64"),
        ("darwin", "arm64"),
    ]
]

go_test(
    name = "fm-steer_test",
    srcs = ["internal/fmsteer/fmsteer_test.go"],
    embed = [":fmsteer_lib"],
)

pkg_tar(
    name = "fm-steer_layer",
    srcs = [":fm-steer"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "fm-steer_image",
    base = "@debian_trixie_slim",
    entrypoint = ["/usr/local/bin/fm-steer"],
    tars = [":fm-steer_layer"],
)

pkg_tar(
    name = "portal_entrypoint_layer",
    srcs = ["deploy/oci-entrypoint.sh"],
    mode = "0755",
    package_dir = "/app",
    strip_prefix = "deploy",
)

# Mozilla CA bundle where Erlang's :pubkey_os_cacerts looks for it.
# oidcc/httpc verifies OIDC discovery TLS against OS paths, not
# SSL_CERT_FILE, and trixie-slim ships no bundle -- without this exact
# path :firstmate_authentik dies with :no_cacerts_found at boot.
# Pattern from serviceradar release_images (ca-certificates.crt).
pkg_files(
    name = "portal_cabundle_files",
    srcs = ["priv/ssl/cacert.pem"],
    prefix = "/etc/ssl/certs",
    renames = {"priv/ssl/cacert.pem": "ca-certificates.crt"},
)

pkg_tar(
    name = "portal_cacert_layer",
    srcs = [":portal_cabundle_files"],
)

# Re-root the Mix release tar under /app. Layering :release directly
# extracts bin/ and lib/ at the filesystem root, replacing Debian's /bin
# (/bin/sh gone) and /lib (glibc gone). Pattern from serviceradar
# elixir_release_rootfs.
pkg_tar(
    name = "portal_release_layer",
    extension = "tar.gz",
    package_dir = "/app",
    deps = [":release"],
)

oci_image(
    name = "portal_image",
    base = "@debian_trixie_slim",
    entrypoint = ["/app/oci-entrypoint.sh"],
    env = {
        "PHX_SERVER": "true",
        "PORT": "4000",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    },
    exposed_ports = ["4000/tcp"],
    tars = [
        ":portal_release_layer",
        ":portal_entrypoint_layer",
        ":portal_cacert_layer",
    ],
    workdir = "/app",
)

oci_push(
    name = "portal_image_push",
    image = ":portal_image",
    repository = "ghcr.io/OWNER/firstmate-port",
)

oci_push(
    name = "fm-steer_image_push",
    image = ":fm-steer_image",
    repository = "ghcr.io/OWNER/fm-steer",
)
