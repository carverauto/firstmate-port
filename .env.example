# Copy to .env. Generate SECRET_KEY_BASE with: mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-mix-phx-gen-secret

# Local compose defaults. Override in docker-compose.override.yml for a real site.
PHX_HOST=localhost
PUBLIC_URL=http://localhost:4000
ALLOWED_EMAIL_DOMAIN=localhost
DEV_AUTH=true

# Optional OIDC (Authentik or any OIDC issuer)
# OIDC_CLIENT_ID=firstmate-port
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_DISCOVERY_URL=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback

# Optional GitHub poll
# GITHUB_TOKEN=
# GITHUB_ORG=

# Optional Discord portal fan-out (the Mac notifier stays in firstmate-notify)
# DISCORD_WEBHOOK_URL=
# DISCORD_PUBLIC_KEY=

# Agent MCP / ingest
# FIRSTMATE_AGENT_TOKEN=

# Optional usage sync + routing intel. Read at runtime, never committed.
# OPENROUTER_API_KEY= (usage sync for OpenRouter accounts + model catalog intel)
# AA_API_KEY= (Artificial Analysis benchmark intel; paid API)
