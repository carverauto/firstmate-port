# Copy to .env. Generate SECRET_KEY_BASE with: openssl rand -base64 48
SECRET_KEY_BASE=replace-me-with-generated-secret

# Local compose defaults. Override in docker-compose.override.yml for a real site.
PHX_HOST=localhost
PUBLIC_URL=http://localhost:4000
ALLOWED_EMAIL_DOMAIN=localhost
DEV_AUTH=true

# Optional OIDC (Authentik or any OIDC issuer)
# OIDC_CLIENT_ID=firstmate-port
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_DISCOVERY_URL=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback

# Optional GitHub poll
# GITHUB_TOKEN=
# GITHUB_ORG=

# Tenant credential encryption: see docs/credentials.md for initial setup,
# fallback derivation, and rotation. Preserve the current key on existing databases.
# CLOAK_KEY=
# CLOAK_KEY_TAG=
# CLOAK_KEYS_RETIRED=

# Agent MCP / ingest
# FIRSTMATE_AGENT_TOKEN=
