# Copy to .env. Generate SECRET_KEY_BASE with: openssl rand -base64 48
SECRET_KEY_BASE=replace-me-with-generated-secret

# Local compose defaults. Override in docker-compose.override.yml for a real site.
PHX_HOST=localhost
PUBLIC_URL=http://localhost:4000
ALLOWED_EMAIL_DOMAIN=localhost
DEV_AUTH=true

# Optional OIDC (Authentik or any OIDC issuer)
# OIDC_CLIENT_ID=firstmate-port
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_DISCOVERY_URL=
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback

# Optional GitHub poll
# GITHUB_TOKEN=
# GITHUB_ORG=

# Encrypts tenant credentials at rest. Generate with: openssl rand -base64 32
# Optional: without it prod derives a key from SECRET_KEY_BASE, which ties stored
# credentials to that value. Dev and test use a checked-in, non-secret key.
# CLOAK_KEY=
# Decrypt-only keys while rotating CLOAK_KEY, as comma-separated tag=base64key
# CLOAK_KEYS_RETIRED=

# Discord interactions verification (outbound webhook sending stays in firstmate-notify).
# Bootstrap only: tenants store their own key at /settings/credentials, which takes
# precedence over this. See docs/credentials.md.
# DISCORD_PUBLIC_KEY=

# Agent MCP / ingest
# FIRSTMATE_AGENT_TOKEN=
