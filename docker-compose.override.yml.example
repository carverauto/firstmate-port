# Copy to docker-compose.override.yml for a site-specific stack.
# ghcr.io is the registry; images are published by CI as
# ghcr.io/<owner>/firstmate-port. Do not invent a second forge.
#
# Example (carverauto LAN):
#
# services:
#   portal:
#     image: ghcr.io/OWNER/firstmate-port:sha-pending
#     environment:
#       PHX_HOST: firstmate.carverauto.dev
#       PUBLIC_URL: https://firstmate.carverauto.dev
#       ALLOWED_EMAIL_DOMAIN: carverauto.dev
#       # Any OpenID Connect issuer; endpoints come from its discovery document.
#       OIDC_ISSUER: https://auth.carverauto.dev/application/o/firstmate/
#       OIDC_CLIENT_ID: firstmate-port
#       OIDC_CLIENT_SECRET: ...
#       LOCAL_AUTH: "false"
#       NATS_REPLICAS: "3"
